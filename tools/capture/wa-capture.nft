#!/usr/sbin/nft -f
# Kernel-level redirect of WhatsApp Web TLS traffic into a local mitmproxy.
#
# What this does: nftables rewrites the destination of outbound TCP/443 packets
# addressed to WhatsApp to the local mitmproxy port 8899 (nat/output hook). The
# browser keeps believing it talks to web.whatsapp.com, and mitmproxy recovers
# the original destination via SO_ORIGINAL_DST.
#
# What this cannot do: decrypt TLS. Traffic is redirected in the kernel, but the
# TLS session is terminated in mitmproxy (userspace), so the browser must trust
# mitmproxy's CA. See docs/capture.md.
#
# Apply:   sudo nft -f tools/capture/wa-capture.nft
# Inspect: sudo nft list table inet wacap
# Remove:  sudo nft delete table inet wacap
#
# Packets from uid 0 are exempt: mitmproxy runs as root, and its own upstream
# connections must not be redirected back into itself (infinite loop).

table inet wacap {
    set wa4 {
        type ipv4_addr
        flags interval
    }

    set wa6 {
        type ipv6_addr
        flags interval
    }

    chain output {
        type nat hook output priority dstnat; policy accept;

        meta skuid 0 return

        ip daddr @wa4 tcp dport 443 redirect to :8899
        # IPv4 only: an IPv4 redirect lands on 127.0.0.1, while a Python socket bound to
        # [::] is v6-only here. Rejecting IPv6 makes the browser fall back to IPv4 fast.
        ip6 daddr @wa6 tcp dport 443 reject
    }
}
